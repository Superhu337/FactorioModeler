<Application x:Class="FactorioModeler.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FactorioModeler"
             StartupUri="MainWindow.xaml">
    
    <Application.Resources>
        
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2f2f2f"/>
            <Setter Property="BorderBrush" Value="#a0a0a0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>


            <!-- Полностью переопределяем шаблон, чтобы убрать системный синий цвет Windows -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Настраиваем скругление углов (CornerRadius="6") и привязываем фоны -->
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>

                        <!-- ТРИГГЕРЫ ПОВЕДЕНИЯ КНОПКИ -->
                        <ControlTemplate.Triggers>
                            <!-- 1. Что происходит при наведении мыши (МЕНЯЕМ ЦВЕТ ТУТ) -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <!-- Например, делаем кнопку чуть светлее (#3f3f3f) вместо стандартного голубого -->
                                <Setter TargetName="border" Property="Background" Value="#3f3f3f"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#c0c0c0"/>
                            </Trigger>

                            <!-- 2. Что происходит при самом клике/нажатии -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1f1f1f"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="FactorioToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#f8f8f8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <!-- Рисуем сам переключатель (тумблер) -->
                            <Border x:Name="SwitchBorder" Width="34" Height="16" Background="#222" BorderBrush="#666" BorderThickness="1" CornerRadius="8" VerticalAlignment="Center">
                                <Ellipse x:Name="Dot" Width="10" Height="10" Fill="White" HorizontalAlignment="Left" Margin="2,0"/>
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <!-- Состояние, когда переключатель включен -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchBorder" Property="Background" Value="#4A5A4A"/>
                                <Setter TargetName="SwitchBorder" Property="BorderBrush" Value="#95f6a8"/>
                                <Setter TargetName="Dot" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- СТИЛЬ ДЛЯ СТРОК СПИСКА (Каждый элемент в рамке) -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="#2f2f2f"/>
            <Setter Property="BorderBrush" Value="#a0a0a0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <!-- Скругляем углы у каждой плашки -->
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Margin="8,0,0,0">
                            <ContentPresenter VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Эффект при наведении на строку -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#2d2d30"/>
                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="#666"/>
                            </Trigger>
                            <!-- Эффект при выделении строки -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#333538"/>
                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="#a0a0a0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
    </Application.Resources>
</Application>

<Window x:Class="FactorioModeler.Views.RecipeCard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FactorioModeler.Views"
        mc:Ignorable="d"
        WindowStyle="None"
        Width="242" Height="126" d:HorizontalAlignment="Center" d:VerticalAlignment="Center"
        Background="Transparent"
        ShowInTaskbar="False"
        AllowsTransparency="True">

    <Grid x:Name="MainGrid" >
        <Grid.RowDefinitions>
            <RowDefinition x:Name="MainRow"/>
            <RowDefinition Height="27" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="46" />
            <ColumnDefinition Width="35" />
            <ColumnDefinition Width="78" />
            <ColumnDefinition Width="35" />
            <ColumnDefinition Width="46" />
        </Grid.ColumnDefinitions>

        <Border x:Name="MainBorder" BorderBrush="#a0a0a0" BorderThickness="3" Grid.RowSpan="2" Grid.Column="1" Grid.ColumnSpan="3" Background="#606060"/>


        <!-- ВХОДЫ (слева) -->
        <StackPanel x:Name="InputsPanel" Grid.Column="1" Margin="3,3,0,0">
            <!-- Иконки входов будут добавлены программно -->
        </StackPanel>

        <!-- ПРОЦЕСС (в центре) -->
        <Border x:Name="ProcessBorder" Grid.Column="2" Background="#606060" VerticalAlignment="Top" Margin="0,3,0,0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image x:Name="ProcessIcon" Source="/ui_icons/mining-default.png" 
                        Width="58" Height="58"/>
            </StackPanel>
        </Border>

        <!-- ВЫХОДЫ (справа) -->
        <StackPanel x:Name="OutputsPanel" Grid.Column="3" Margin="0,3,3,0">
            <!-- Иконки выходов будут добавлены программно -->
        </StackPanel>



        <TextBlock x:Name="Cur_Out" Text="Cur OUT" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Bottom" Height="16" Foreground="#f8f8f8" Grid.Column="2" Grid.Row="0"/>
        <TextBlock x:Name="Input" Text="input" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="#f8f8f8" Grid.Column="0" Margin="0,11,0,0"/>
        <TextBlock x:Name="Output" Text="output" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="#f8f8f8" Grid.Column="4" Margin="0,11,0,0"/>

        <Border Background="#2f2f2f" Grid.Row="1" Grid.Column="1"  Margin="3,0,3,3" Grid.ColumnSpan="3">
            <TextBlock x:Name="Limit" Text="Limit" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#f8f8f8"/>
        </Border>
    </Grid>


</Window>

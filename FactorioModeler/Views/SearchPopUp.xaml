<Window x:Class="FactorioModeler.Views.SearchPopUp"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FactorioModeler.Views"
        mc:Ignorable="d"
        Title="SearchPopUp" Height="439" Width="595"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        KeyDown="Window_KeyDown"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <!-- СТИЛЬ ДЛЯ ПЕРЕКЛЮЧАТЕЛЕЙ (Recipe Name, Inputs, Outputs) -->
        <Style x:Key="FactorioToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#f8f8f8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <!-- Рисуем сам переключатель (тумблер) -->
                            <Border x:Name="SwitchBorder" Width="34" Height="16" Background="#222" BorderBrush="#666" BorderThickness="1" CornerRadius="8" VerticalAlignment="Center">
                                <Ellipse x:Name="Dot" Width="10" Height="10" Fill="White" HorizontalAlignment="Left" Margin="2,0"/>
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <!-- Состояние, когда переключатель включен -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchBorder" Property="Background" Value="#4A5A4A"/>
                                <Setter TargetName="SwitchBorder" Property="BorderBrush" Value="#95f6a8"/>
                                <Setter TargetName="Dot" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- СТИЛЬ ДЛЯ СТРОК СПИСКА (Каждый элемент в рамке) -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="#2f2f2f"/>
            <Setter Property="BorderBrush" Value="#a0a0a0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <!-- Скругляем углы у каждой плашки -->
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Margin="8,0,0,0">
                            <ContentPresenter VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Эффект при наведении на строку -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#2d2d30"/>
                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="#666"/>
                            </Trigger>
                            <!-- Эффект при выделении строки -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#333538"/>
                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="#a0a0a0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#1f1f1f" 
            BorderBrush="#a0a0a0" 
            BorderThickness="2" 
            CornerRadius="0" 
            Padding="8">

            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Строка поиска -->
                <RowDefinition Height="Auto"/>
                <!-- Фильтры -->
                <RowDefinition Height="*"/>
                <!-- Список результатов -->
            </Grid.RowDefinitions>

            <!-- 1. ВЕРХНЯЯ ПАНЕЛЬ: Поле ввода поиска -->
            <Border Grid.Row="0" BorderBrush="#a0a0a0" BorderThickness="2" CornerRadius="2" Background="#2f2f2f" Margin="8">
                <Grid>
                    <!-- Иконка поиска (Лупа) -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Search_Click" HorizontalAlignment="Left" Width="40" Height="40" VerticalAlignment="Top">
                        <Rectangle Width="19" Height="19" Fill="#f8f8f8">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="/ui_icons/search.png" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </Button>

                    <!-- Поле ввода текста -->
                    <TextBox Grid.Column="1"
                                Background="Transparent" 
                                BorderThickness="0" 
                                Foreground="#f8f8f8" 
                                FontSize="16" 
                                VerticalContentAlignment="Center" 
                                CaretBrush="#f8f8f8" Height="36"
                                x:Name="SearchTextBox" 
                                TextChanged="SearchTextBox_TextChanged" />

                    <!-- Кнопка отчистки поиска -->
                    <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="ClearButton_Click" Width="40">
                        <Rectangle Width="19" Height="19" Fill="#f8f8f8">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="/ui_icons/red-x-line.png" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </Button>

                </Grid>
            </Border>

            <!-- 2. СРЕДНЯЯ ПАНЕЛЬ: Переключатели фильтрации -->
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,8,0,8">
                <ToggleButton x:Name="ToggleRecipeName" Content="Recipe Name" Style="{StaticResource FactorioToggle}" HorizontalAlignment="Center" IsChecked="True" Checked="SearchSettings_Changed" Unchecked="SearchSettings_Changed"/>
                <ToggleButton x:Name="ToggleInputs" Content="Inputs" Style="{StaticResource FactorioToggle}" HorizontalAlignment="Center" Checked="SearchSettings_Changed" Unchecked="SearchSettings_Changed"/>
                <ToggleButton x:Name="ToggleOutputs" Content="Outputs" Style="{StaticResource FactorioToggle}" HorizontalAlignment="Center" Checked="SearchSettings_Changed" Unchecked="SearchSettings_Changed"/>
            </UniformGrid>

            <!-- 3. НИЖНЯЯ ПАНЕЛЬ: Результаты (Скроллбар появится автоматически) -->
            <ListBox x:Name="ResultsListBox" 
                     Grid.Row="2" 
                     Background="Transparent" 
                     BorderThickness="0" 
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="5">
                            <TextBlock Text="{Binding Name}" Foreground="#f8f8f8" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Category}" Foreground="#a0a0a0" FontSize="11"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</Window>

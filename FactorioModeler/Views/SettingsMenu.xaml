<UserControl x:Class="FactorioModeler.Views.SettingsMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FactorioModeler.Views"
             mc:Ignorable="d" 
             >

    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2f2f2f"/>
            <Setter Property="BorderBrush" Value="#a0a0a0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>


            <!-- Полностью переопределяем шаблон, чтобы убрать системный синий цвет Windows -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Настраиваем скругление углов (CornerRadius="6") и привязываем фоны -->
                        <Border x:Name="border" 
                Background="{TemplateBinding Background}" 
                BorderBrush="{TemplateBinding BorderBrush}" 
                BorderThickness="{TemplateBinding BorderThickness}" 
                CornerRadius="6" 
                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>

                        <!-- ТРИГГЕРЫ ПОВЕДЕНИЯ КНОПКИ -->
                        <ControlTemplate.Triggers>
                            <!-- 1. Что происходит при наведении мыши (МЕНЯЕМ ЦВЕТ ТУТ) -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <!-- Например, делаем кнопку чуть светлее (#3f3f3f) вместо стандартного голубого -->
                                <Setter TargetName="border" Property="Background" Value="#3f3f3f"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#c0c0c0"/>
                            </Trigger>

                            <!-- 2. Что происходит при самом клике/нажатии -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1f1f1f"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Главная внешняя темная плашка меню с серой рамкой -->
    <Border Background="#1a1c1e" BorderBrush="#a0a0a0" BorderThickness="1.5" CornerRadius="2" Width="171" Padding="8">
        <StackPanel>

            <!-- ВЕРХНИЙ РЯД: Две кнопки со стрелочками рядом друг с другом -->
            <UniformGrid Columns="2" Margin="0,0,0,8">
                <!-- Стрелочка Назад -->
                <Button Click="Undo_Click" Background="#2f2f2f" BorderBrush="#a0a0a0" BorderThickness="1" Height="38" Margin="0,0,4,0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                    <Rectangle Width="19" Height="19" Fill="#f8f8f8">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="/ui_icons/undo.png"/>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </Button>

                <!-- Стрелочка Вперед -->
                <Button Click="Redo_Click" Background="#2f2f2f" BorderBrush="#a0a0a0" BorderThickness="1" Height="38" Margin="4,0,0,0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                    <Rectangle Width="19" Height="19" Fill="#f8f8f8">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="/ui_icons/redo.png"/>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </Button>
            </UniformGrid>

            <!-- СПИСОК ОСНОВНЫХ КНОПОК МЕНЮ -->
            <!-- Стиль внутри кнопок автоматически закругляет им углы (CornerRadius="6") -->

            <!-- Import -->
            <Button Click="Import_Click" Background="#2f2f2f" BorderBrush="#a0a0a0" BorderThickness="1" Height="38" Margin="0,0,0,6" Cursor="Hand" HorizontalContentAlignment="Left">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
                <StackPanel Orientation="Horizontal" Margin="15,0,0,0">
                    <Rectangle Width="19" Height="19" Fill="#f8f8f8" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="/ui_icons/import.png"/>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock Text="Import" Foreground="#f8f8f8" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Export -->
            <Button Click="Export_Click" Background="#2f2f2f" BorderBrush="#a0a0a0" BorderThickness="1" Height="38" Margin="0,0,0,6" Cursor="Hand" HorizontalContentAlignment="Left">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
                <StackPanel Orientation="Horizontal" Margin="15,0,0,0">
                    <Rectangle Width="19" Height="19" Fill="#f8f8f8" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="/ui_icons/export.png"/>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock Text="Export" Foreground="#f8f8f8" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Refresh -->
            <Button Click="Refresh_Click" Background="#2f2f2f" BorderBrush="#a0a0a0" BorderThickness="1" Height="38" Margin="0,0,0,6" Cursor="Hand" HorizontalContentAlignment="Left">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
                <StackPanel Orientation="Horizontal" Margin="15,0,0,0">
                    <Rectangle Width="19" Height="19" Fill="#f8f8f8" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="/ui_icons/update.png"/>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock Text="Update" Foreground="#f8f8f8" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Settings -->
            <Button Click="Settings_Click" Background="#2f2f2f" BorderBrush="#a0a0a0" BorderThickness="1" Height="38" Margin="0,0,0,6" Cursor="Hand" HorizontalContentAlignment="Left">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
                <StackPanel Orientation="Horizontal" Margin="15,0,0,0">
                    <Rectangle Width="19" Height="19" Fill="#f8f8f8" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="/ui_icons/settings.png"/>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock Text="Settings" Foreground="#f8f8f8" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Exit -->
            <Button Click="Exit_Click" Background="#2f2f2f" BorderBrush="#a0a0a0" BorderThickness="1" Height="38" Margin="0,0,0,6" Cursor="Hand" HorizontalContentAlignment="Left">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
                <StackPanel Orientation="Horizontal" Margin="15,0,0,0">
                    <Rectangle Width="19" Height="19" Fill="#f8f8f8" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="/ui_icons/clear.png"/>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock Text="Exit" Foreground="#f8f8f8" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

        </StackPanel>
    </Border>
</UserControl>
